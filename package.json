{
  "name": "grokbot-shim",
  "version": "1.0.0",
  "description": "Run the Grok Bot desktop agent with a ChatGPT plan model backend.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "auth": "node shim/auth.mjs",
    "connector-client": "node shim/connectors.mjs",
    "gen-proto": "node scripts/gen-proto.mjs",
    "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/grokbot-windows.ps1",
    "windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "windows:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1 -Uninstall",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "agent",
    "computer-use",
    "grok",
    "llm"
  ],
  "author": "luckeyfaraday",
  "license": "ISC",
  "private": false,
  "dependencies": {
    "protobufjs": "^8.7.2"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1"
  }
}
